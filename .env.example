# WorkFinder environment template.
# Local: copy to .env.local (never commit it). Production: set these in your
# host's secret manager (Render/Docker/AWS); they override any .env file.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Exact public origin, no path. Must be https:// in production.
APP_ORIGIN=http://localhost:3000
# 0 locally; 1 behind a single reverse proxy (Render, a load balancer).
TRUST_PROXY_HOPS=0

# --- Supabase (required) ---------------------------------------------------
SUPABASE_URL=
# Public anon/publishable key: safe to expose to the browser.
SUPABASE_ANON_KEY=
# SERVER ONLY. Never put this in frontend code or a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (optional) -----------------------------------------------------
# Leave empty to run AI features in offline fallback mode (guided interview,
# keyword match estimate, template cover letter). Server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Job sources ------------------------------------------------------------
# Work with no key: Работа России (trudvsem.ru), Remotive, RemoteOK, Himalayas,
# Jobicy, Arbeitnow. A source without its key is simply skipped.
#
# HeadHunter (hh.kz / hh.ru): register an app at https://dev.hh.ru/ and get an
# application token (grant_type=client_credentials). Main source for KZ/RU.
HH_USER_AGENT=WorkFinder/2.0 (you@example.com)
HH_ACCESS_TOKEN=
# Jooble (KZ, RU and more): request a key at https://jooble.org/api/about
JOOBLE_API_KEY=
# Careerjet (KZ, RU and more): publisher API key at https://www.careerjet.com/partners/api/
CAREERJET_API_KEY=
# Adzuna (UK, US, DE, PL and ~15 more countries): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# HeadHunter application (dev.hh.ru/admin). Run `node scripts/hh-token.mjs` to fill HH_ACCESS_TOKEN.
HH_CLIENT_ID=
HH_CLIENT_SECRET=

# Google OAuth Web client ID (public). Enables the on-site Google button; see README.
GOOGLE_CLIENT_ID=
